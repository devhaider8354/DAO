{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "DAO",
  "version": "2.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}